// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Aluno {
  id            String          @id @default(uuid())
  nome          String
  email         String          @unique
  senha         String
  personalId    String? // vazio até o personal aceitar
  personal      Personal?       @relation(fields: [personalId], references: [id])
  solicitacoes  Solicitacao[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  fichas        Ficha[]
  sessao_treino Sessao_Treino[]
}

model Personal {
  id           String        @id @default(uuid())
  nome         String
  email        String        @unique
  senha        String
  alunos       Aluno[]
  fichas       Ficha[]
  solicitacoes Solicitacao[]
}

model Ficha {
  id            String          @id @default(uuid())
  alunoId       String
  aluno         Aluno           @relation(fields: [alunoId], references: [id])
  personalId    String
  personal      Personal        @relation(fields: [personalId], references: [id])
  sessao_treino Sessao_Treino[]
  itens         Item_Ficha[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Sessao_Treino {
  id              String            @id @default(uuid())
  alunoId         String
  aluno           Aluno             @relation(fields: [alunoId], references: [id])
  fichaId         String
  ficha           Ficha             @relation(fields: [fichaId], references: [id])
  serie_executada Serie_Executada[]
  data            DateTime
  situacao        SituacaoSessao    @default(em_andamento)
}

enum SituacaoSessao {
  em_andamento
  finalizada
}

model Serie_Executada {
  id               String        @id @default(uuid())
  sessao_treinoId  String
  sessao_treino    Sessao_Treino @relation(fields: [sessao_treinoId], references: [id])
  numero_Serie     Int
  cargaUsada       Float
  repeticoesFeitas Int
  itemFichaId      String
  itemFicha        Item_Ficha    @relation(fields: [itemFichaId], references: [id])
}

enum TipoExercicio {
  forca
  cardio
}

model Item_Ficha {
  id      String @id @default(uuid()) // <- era o que faltava
  fichaId String
  ficha   Ficha  @relation(fields: [fichaId], references: [id])
  ordem   Int

  // Catálogo OU personalizado
  exercicioId       String?
  exercicio         Exercicio? @relation(fields: [exercicioId], references: [id])
  nomePersonalizado String?

  tipo TipoExercicio @default(forca)

  // Força
  seriesAlvo     Int?
  repeticoesAlvo Int?
  cargaSugerida  Float?

  // Cardio
  duracaoMin    Int?
  velocidadeKmh Float?
  inclinacaoPct Float?

  series Serie_Executada[] // <- relação inversa da Serie_Executada
}

model Exercicio {
  id            String       @id @default(uuid())
  nome          String       @unique
  grupoMuscular String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  item_ficha    Item_Ficha[]
}

model Solicitacao {
  id         String   @id @default(uuid())
  alunoId    String
  aluno      Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  personalId String
  personal   Personal @relation(fields: [personalId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([alunoId, personalId]) // impede pedido repetido para o mesmo personal
}
